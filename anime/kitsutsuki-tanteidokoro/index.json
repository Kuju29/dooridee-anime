{"id":"108629","t":{"th":"สำนักงานนักสืบนกหัวขวาน","ro":"Kitsutsuki Tantei Dokoro","en":"Woodpecker Detective’s Office","na":"啄木鳥探偵處"},"cover":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx108629-KZRQimMl3eGN.jpg","coverM":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx108629-KZRQimMl3eGN.jpg","color":"#a1d6e4","banner":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/108629-FOCCY5WmkVzh.jpg","fmt":"TV","status":"FINISHED","eps":12,"dur":24,"season":"SPRING","year":2020,"start":"2020-04-13","country":"JP","genres":["Mystery"],"score":57,"pop":9736,"studio":"LIDENFILMS","desc":"Adaptation of Kei Ii's mystery novel.\n\nThe story is set in 1909 during Japan's Meiji era, and centers on fictional versions of real-life poet Takuboku Ishikawa and real-life linguist Kyousuke Kindaichi, who were acquaintances in real life. Takuboku runs a private detective agency to support his family. Both begin to investigate a case of supposed ghost appearances at the Asakusa Junikai building, also known as the Ryounkai.","descTh":"ดัดแปลงจากนิยายลึกลับของ Kei Ii\n\nเรื่องราวเกิดขึ้นในปี 1909 ในยุคเมจิของญี่ปุ่น และมุ่งเน้นไปที่เวอร์ชันสมมติของกวีในชีวิตจริง ทาคุโบกุ อิชิกาวะ และนักภาษาศาสตร์ในชีวิตจริง เคียวสุเกะ คินไดจิ ซึ่งเคยรู้จักกันในชีวิตจริง ทาคุโบกุเปิดสำนักงานนักสืบเอกชนเพื่อช่วยเหลือครอบครัวของเขา ทั้งสองเริ่มสืบสวนคดีที่คาดว่าผีปรากฏตัวที่อาคารอาซากุสะ จูนิไค หรือที่รู้จักกันในชื่อเรียวนไค","src":{"meta":"anilist","th":"licensor","descTh":"gtranslate"},"trailer":"dhEiqdAWjwI","al":"https://anilist.co/anime/108629","mal":"https://myanimelist.net/anime/39582","jp":null,"sched":[],"prov":[{"p":"bilibili","r":"TH","u":"https://www.bilibili.tv/th/play/35691","lang":"sub","eps":[["1","https://www.bilibili.tv/th/play/35691/360869",1606064640,"x","b:m201110a23jzb3842dobmz3v8qmpg0vy.jpg",null,{}],["2","https://www.bilibili.tv/th/play/35691/360872",1606064640,"x","b:m201110a23h4b75sjopw3z34wmzghfpi.jpg",null,{}],["3","https://www.bilibili.t